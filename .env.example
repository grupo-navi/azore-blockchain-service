# ===========================================
# AZORE BLOCKCHAIN SERVICE - ENVIRONMENT VARIABLES
# ===========================================

# ------------------------------------------
# NETWORK CONFIGURATION
# ------------------------------------------
# Ambiente ativo: "testnet" ou "mainnet"
NETWORK=testnet

# ------------------------------------------
# AZORE TESTNET
# ------------------------------------------
AZORE_TESTNET_RPC_URL=https://rpc-testnet.azore.technology
AZORE_TESTNET_CHAIN_ID=88001
AZORE_TESTNET_EXPLORER_URL=https://floripa.azorescan.com
AZORE_TESTNET_EXPLORER_API_URL=https://floripa.azorescan.com/api

# ------------------------------------------
# AZORE MAINNET
# ------------------------------------------
AZORE_MAINNET_RPC_URL=https://rpc-mainnet.azore.technology
AZORE_MAINNET_CHAIN_ID=8800
AZORE_MAINNET_EXPLORER_URL=https://azorescan.com
AZORE_MAINNET_EXPLORER_API_URL=https://azorescan.com/api

# ------------------------------------------
# API SERVER CONFIGURATION
# ------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0
API_PREFIX=/api/v1

# ------------------------------------------
# SECURITY
# ------------------------------------------
# Chave para autenticação da API (deixe vazio para desabilitar)
API_KEY=

# Secret para JWT tokens
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Chave para criptografia de wallets (AES-256)
ENCRYPTION_KEY=your-32-character-encryption-key-change-this

# Secret para validação de webhooks
WEBHOOK_SECRET=your-webhook-secret-key

# ------------------------------------------
# RATE LIMITING
# ------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------
# LOGGING
# ------------------------------------------
# Níveis: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Salvar logs em arquivo
LOG_TO_FILE=false
LOG_FILE_PATH=./logs

# ------------------------------------------
# BLOCKCHAIN SETTINGS
# ------------------------------------------
# Número de confirmações para considerar transação finalizada
DEFAULT_CONFIRMATIONS=3

# Timeout para transações (em segundos)
TRANSACTION_TIMEOUT=300

# Gas limit padrão
DEFAULT_GAS_LIMIT=200000

# ------------------------------------------
# CACHE CONFIGURATION (Opcional)
# ------------------------------------------
ENABLE_CACHE=true
CACHE_TTL=300

# ------------------------------------------
# WEBHOOK CONFIGURATION
# ------------------------------------------
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=5000

# ------------------------------------------
# DATABASE (Opcional - para histórico)
# ------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/azore_service
# DB_ENABLE=false

# ------------------------------------------
# MONITORING (Opcional)
# ------------------------------------------
# SENTRY_DSN=
# ENABLE_MONITORING=false

# ------------------------------------------
# CORS
# ------------------------------------------
CORS_ORIGIN=*
